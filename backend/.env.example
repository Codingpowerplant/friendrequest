# Copy this file to .env and fill in your values.
# cp .env.example .env

# Server port (default: 5000)
PORT=5000

# MongoDB connection string
# Local:  mongodb://localhost:27017/farmershub
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/farmershub
MONGO_URI=mongodb+srv://Farmershub:YOUR_ACTUAL_PASSWORD_HERE@cluster0.fndj48h.mongodb.net/?appName=Cluster0

# JWT signing secret — change this in any non-development environment
JWT_SECRET=your_jwt_secret_here

# Allowed CORS origins (comma-separated)
# Include local frontend origins and your deployed frontend domain.
# Example deployed frontend: https://<username>.github.io
CLIENT_ORIGIN=https://your-frontend-domain.com

# Set to true to skip MongoDB and use in-memory store (demo / quick testing)
USE_IN_MEMORY_DB=false
